rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(householdId) {
      return signedIn() && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
      match /favorites/{favoriteId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['householdId', 'itemId'])
          && member(request.resource.data.householdId)
          && exists(/databases/$(database)/documents/households/$(request.resource.data.householdId)/items/$(request.resource.data.itemId));
      }
    }
    match /households/{householdId} {
      allow read: if member(householdId);
      allow write: if false;
      match /members/{userId} {
        allow read: if member(householdId);
        allow write: if false;
      }
      match /locations/{locationId} {
        allow read: if member(householdId);
        allow write: if false;
      }
      match /items/{itemId} {
        allow read: if member(householdId);
        allow write: if false;
      }
      match /loans/{loanId} {
        allow read: if member(householdId);
        allow write: if false;
      }
    }
  }
}
