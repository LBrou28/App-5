rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /households/{householdId}/items/{itemId}/{fileName} {
      function member() {
        return request.auth != null && firestore.exists(/databases/(default)/documents/households/$(householdId)/members/$(request.auth.uid));
      }
      allow read: if member();
      allow create, update: if member() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if member();
    }
  }
}
